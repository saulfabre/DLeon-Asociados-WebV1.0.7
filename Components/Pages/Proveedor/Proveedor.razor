@page "/Proveedores"
@using Microsoft.AspNetCore.Components.QuickGrid
@using DLeon_Asociados_Web.Services
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject ProveedoresStore ProveedoresStore

<AdminLayout ActivePage="suppliers">
    <div class="pagina-proveedores">
        <header class="header-proveedores admin-page-header">
            <h1>Proveedores</h1>
            <a class="btn btn-primary" href="/Proveedores/Crear">
                <i class="cil-plus" aria-hidden="true"></i> Agregar Proveedor
            </a>
        </header>

        <main class="contenido-proveedores">
            <div class="contenido-card">
            <div class="filtros">
                <label class="busqueda-proveedores">
                    <i class="cil-search" aria-hidden="true"></i>
                    <input type="search" placeholder="Buscar proveedor por nombre o código..."
                           @bind="TextoBusqueda" @bind:event="oninput" @bind:after="ReiniciarPaginacion" />
                </label>

                <select class="form-select filtro-estado" aria-label="Filtrar por estado"
                        @bind="EstadoFiltro" @bind:after="ReiniciarPaginacion">
                    <option value="">Todos los estados</option>
                    <option value="Activo">Activo</option>
                    <option value="Inactivo">Inactivo</option>
                </select>

                <select class="form-select filtro-ciudad" aria-label="Filtrar por ciudad"
                        @bind="CiudadFiltro" @bind:after="ReiniciarPaginacion">
                    <option value="">Todas las ciudades</option>
                    @foreach (var ciudad in Proveedores.Select(proveedor => proveedor.Ciudad).Distinct().OrderBy(ciudad => ciudad))
                    {
                        <option value="@ciudad">@ciudad</option>
                    }
                </select>

                <div class="acciones-filtros">
                    <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarFiltros">
                        Limpiar filtros
                    </button>
                    <button class="btn btn-primary btn-imprimir" type="button" @onclick="ImprimirReporte">
                        <i class="cil-print" aria-hidden="true"></i> Generar reporte
                    </button>
                </div>
            </div>

            @if (ProveedoresFiltrados.Count == 0)
            {
                <div class="estado-vacio">
                    @(Proveedores.Count == 0
                        ? "No hay proveedores registrados."
                        : "No hay proveedores que coincidan con los filtros.")
                </div>
            }
            else
            {
                <div class="tabla-responsive">
                    <QuickGrid @key="ClaveFiltros" TGridItem="ProveedoresStore.ProveedorRegistro"
                               Items="@ProveedoresFiltrados.AsQueryable()" Pagination="@Paginacion"
                               Class="table table-bordered table-hover align-middle tabla-proveedores">
                        <PropertyColumn Property="proveedor => proveedor.Nombre" Title="Proveedor" Sortable="true" />
                        <PropertyColumn Property="proveedor => proveedor.Documento" Title="Cédula/RNC" Sortable="true" />
                        <PropertyColumn Property="proveedor => proveedor.Telefono" Title="Teléfono" />
                        <PropertyColumn Property="proveedor => proveedor.Correo" Title="Correo" />
                        <PropertyColumn Property="proveedor => proveedor.Ciudad" Title="Ciudad" Sortable="true" />
                        <TemplateColumn Title="Estado" Sortable="true" SortBy="OrdenEstado" Context="proveedor">
                            @proveedor.Estado
                        </TemplateColumn>
                        <TemplateColumn Title="Acciones" Class="no-print" Context="proveedor">
                            <div class="acciones-registro">
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@($"/Proveedores/Editar?proveedor={Uri.EscapeDataString(proveedor.Nombre)}")"
                                   aria-label="@($"Editar {proveedor.Nombre}")">
                                    <i class="cil-pencil" aria-hidden="true"></i>
                                </a>
                                <button class="btn btn-sm btn-outline-danger" type="button"
                                        aria-label="@($"Eliminar {proveedor.Nombre}")">
                                    <i class="cil-trash" aria-hidden="true"></i>
                                </button>
                            </div>
                        </TemplateColumn>
                    </QuickGrid>
                    <Paginator State="@Paginacion" />
                </div>
            }
            </div>
        </main>
    </div>
</AdminLayout>

@code {
    private readonly PaginationState Paginacion = new() { ItemsPerPage = 10 };
    private IReadOnlyList<ProveedoresStore.ProveedorRegistro> Proveedores => ProveedoresStore.ObtenerTodos();
    private string TextoBusqueda = string.Empty;
    private string EstadoFiltro = string.Empty;
    private string CiudadFiltro = string.Empty;

    private static GridSort<ProveedoresStore.ProveedorRegistro> OrdenEstado { get; } =
        GridSort<ProveedoresStore.ProveedorRegistro>.ByAscending(proveedor => proveedor.Estado);

    private List<ProveedoresStore.ProveedorRegistro> ProveedoresFiltrados => Proveedores
        .Where(proveedor => string.IsNullOrWhiteSpace(TextoBusqueda) ||
            proveedor.Nombre.Contains(TextoBusqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
            proveedor.Documento.Contains(TextoBusqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
            proveedor.Telefono.Contains(TextoBusqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
            proveedor.Correo.Contains(TextoBusqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
            proveedor.Ciudad.Contains(TextoBusqueda.Trim(), StringComparison.OrdinalIgnoreCase))
        .Where(proveedor => string.IsNullOrWhiteSpace(EstadoFiltro) || proveedor.Estado == EstadoFiltro)
        .Where(proveedor => string.IsNullOrWhiteSpace(CiudadFiltro) || proveedor.Ciudad == CiudadFiltro)
        .ToList();

    private string ClaveFiltros => $"{TextoBusqueda}|{EstadoFiltro}|{CiudadFiltro}";

    private async Task LimpiarFiltros()
    {
        TextoBusqueda = string.Empty;
        EstadoFiltro = string.Empty;
        CiudadFiltro = string.Empty;
        await ReiniciarPaginacion();
    }

    private Task ReiniciarPaginacion() => Paginacion.SetCurrentPageIndexAsync(0);

    private Task ImprimirReporte() => JS.InvokeVoidAsync("window.print").AsTask();


}
